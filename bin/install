#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/utils.bash"
require_version
# Older asdf versions can call install without a separate download step.
if [ ! -x "$ASDF_DOWNLOAD_PATH/panko" ] || [ ! -x "$ASDF_DOWNLOAD_PATH/panko-admin" ]; then
  download_release
fi
mkdir -p "$ASDF_INSTALL_PATH/bin"
cp "$ASDF_DOWNLOAD_PATH/panko" "$ASDF_DOWNLOAD_PATH/panko-admin" "$ASDF_INSTALL_PATH/bin/"
chmod 755 "$ASDF_INSTALL_PATH/bin/panko" "$ASDF_INSTALL_PATH/bin/panko-admin"
